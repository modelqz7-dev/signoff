# Supabase project settings -> API. Required at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only (set in Vercel → Settings → Environment Variables; never NEXT_PUBLIC) ---
# Supabase → Project Settings → API → service_role key. Used only by /api routes.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string (letters, digits, _ or -). Must match the x-webhook-secret header
# of the Supabase database webhooks; also secures the Telegram webhook.
NOTIFY_WEBHOOK_SECRET=

# Telegram notifications: create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# Bot username without @, e.g. nodly_notify_bot (public, shown as t.me link).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Email notifications via Resend (resend.com). Verify your domain there to send to anyone.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=Nodly <notify@your-domain.com>

# Optional: public site URL for links in notifications (defaults to the request origin).
NEXT_PUBLIC_SITE_URL=

# Daily reminder emails to clients (vercel.json → crons). Any long random string;
# Vercel sends it to /api/cron/reminders automatically once it is set.
CRON_SECRET=
